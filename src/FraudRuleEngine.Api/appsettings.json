{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RuleSet": {
    "Version": "2026.09.1",
    "Scoring": {
      "LowSeverityWeight": 10,
      "MediumSeverityWeight": 25,
      "HighSeverityWeight": 45,
      "ReviewThreshold": 40,
      "DeclineThreshold": 75
    },
    "Rules": {
      "HighValueTransaction": {
        "Thresholds": {
          "Zar": 25000,
          "Usd": 1500,
          "Eur": 1400,
          "Gbp": 1200
        }
      },
      "FirstTimeMerchantHighValue": {
        "Thresholds": {
          "Zar": 5000,
          "Usd": 300,
          "Eur": 280,
          "Gbp": 240
        },
        "MinimumBaselineTransactions": 10
      },
      "HighRiskCategory": {
        "Categories": [ "Gambling", "Cryptocurrency", "InternationalTransfer" ]
      },
      "DeniedMerchant": {
        "MerchantIds": [ "MERCH-DENY-0001", "MERCH-DENY-0002", "MERCH-DENY-0003" ]
      },
      "UnusualHour": {
        "WindowStart": "01:00",
        "WindowEnd": "05:00"
      },
      "AmountEscalation": {
        "Multiple": 5,
        "MinimumBaselineTransactions": 10
      },
      "TransactionVelocity": {
        "Threshold": 5,
        "Window": "00:15:00"
      },
      "ImpossibleTravel": {
        "MaximumSpeedKilometresPerHour": 1000,
        "Window": "12:00:00"
      }
    }
  }
}
