# Copy to .env to override the compose defaults. Compose reads .env automatically, and .env is
# ignored by git, so a value put here does not reach the repository.
#
# The defaults in compose.yaml are throwaway local values and the stack runs without this file.
# Anything resembling a real credential belongs here, or in a secret manager, and never in a
# tracked file.

# POSTGRES_USER=fraudengine
# POSTGRES_PASSWORD=fraudengine
# POSTGRES_DB=fraudengine
